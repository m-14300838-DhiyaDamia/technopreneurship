# ==========================================================================
# Technopreneurship Final Assessment Management System - environment template
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file. It is excluded by .gitignore.
# ==========================================================================

# ---- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
# How long a login stays valid (e.g. 8h, 12h, 1d)
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed frontend origins (only needed when the
# frontend is hosted separately, e.g. on GitHub Pages).
CORS_ORIGIN=http://localhost:5173

# ---- Data storage ---------------------------------------------------------
# "sheets" = Google Sheets (production). "local" = JSON files on disk (demo/testing).
DATA_STORE=local
# Folder used by the local store
LOCAL_DATA_DIR=./data-local

# ---- Google Sheets (required when DATA_STORE=sheets) ----------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service-account JSON file. Keep the quotes
# and the literal \n characters exactly as they appear in the JSON file.
GOOGLE_PRIVATE_KEY=""
# How often (seconds) the server refreshes its cache from Google Sheets
SHEETS_REFRESH_SECONDS=60
# How often (milliseconds) queued writes are flushed to Google Sheets
SHEETS_FLUSH_MS=2500

# ---- Course / assessment identity -----------------------------------------
COURSE_CODE=DAT
COURSE_NAME=Technopreneurship
ASSESSMENT_TITLE=Technopreneurship Final Assessment
SEMESTER=2026/2027
INSTITUTION_NAME=Universiti Tun Hussein Onn Malaysia (UTHM)
DEPARTMENT_NAME=Jabatan Teknologi Maklumat (JTM)
CENTRE_NAME=Pusat Pengajian Diploma
PROGRAMME_NAME=Diploma Teknologi Maklumat (DAT)

# ---- Monitoring / privacy -------------------------------------------------
# Default camera requirement for new assessments (true/false)
CAMERA_REQUIRED_DEFAULT=true
# Days to keep monitoring (proctoring) events before they may be purged
MONITORING_RETENTION_DAYS=90
# Comma-separated STUN/TURN servers for the lecturer live camera view.
# A TURN server is normally required when students are outside the campus network.
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# ---- Demo data ------------------------------------------------------------
# When true, the demo seed creates DEMO accounts with the password below.
DEMO_PASSWORD=Demo@2026
