{
  "name": "Technopreneurship Final Assessment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [5173, 4000],
  "portsAttributes": {
    "5173": { "label": "Web application (open this)", "onAutoForward": "openBrowser" },
    "4000": { "label": "API server", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm run install:all && npm run seed:demo",
  "postAttachCommand": "bash scripts/codespaces-start.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "settings": { "terminal.integrated.defaultProfile.linux": "bash" } }
  }
}
